# ── TESTING MODE — everything on one machine, one node per store ─────────────
#
# dev_notes.md ("A. Testing — everything on one machine") is the authority for
# this procedure. The three container commands are repeated here for convenience,
# but they are NOT the whole first run: steps 3–5 below fill the stores, and
# without them the dashboard comes up correctly and completely empty.
#
#   # 1. stores (these create pipeline_network)
#   docker compose --env-file .env.testing -f docker-compose.stores.yml up -d
#   # 2. pipeline — validation creates schema, seeder populates test profiles
#   docker compose --env-file .env.testing up -d --build
#   # 3. the 30-day history (optional)
#   ./bootstrap/silver_snapshot.sh restore
#   # 4. the dashboard
#   docker compose -f 5-serving/docker-compose.serving.yml up --build
#   # 5. pre-computed gold             (optional; saves ~2 min of waiting)
#   ./bootstrap/gold_snapshot.sh restore
#   # 6. the dashboard
#   docker compose -f 5-serving/docker-compose.serving.yml up --build
#
# Shutting down, in reverse order. NONE of these take -v, so every volume — and
# therefore all silver, gold, profiles and tags — survives:
#
#   docker compose -f 5-serving/docker-compose.serving.yml down
#   docker compose --env-file .env.testing down
#   docker compose --env-file .env.testing -f docker-compose.stores.yml down
#
# Restarting after that needs steps 1, 2 and 6 only — the stores are already
# full. Adding -v to any of the three DESTROYS the volumes, and the full six-step
# sequence is then required again.
#
# Optionally, before shutting down, trim the live slices so only the shipped
# 30-day history remains (see dev_notes.md):
#
#   docker compose --env-file .env.testing stop ingestion parsing validation
#   ./bootstrap/silver_snapshot.sh trim seed
#   docker compose --env-file .env.testing restart processing
#
# Starts 4 store containers instead of 13 (~2 GB instead of ~6.1 GB), which is
# what makes the stack usable on a machine with 8 GB of RAM. Note the absence of
# `--profile full`: the redundant nodes are gated behind that profile and simply
# do not start here.
#
# No store addresses are set, so the compose defaults apply and every service is
# reached by its Docker service name on the shared network.

# Single-node ClickHouse topology (1 shard × 1 replica, 1 Keeper).
CH_CLUSTER_CONFIG=cluster.local.xml
CH_KEEPER1_CONFIG=keeper-1.local.xml

# Names this mode's ClickHouse and Keeper volumes. Intended mode uses a different
# prefix, so the two topologies never share coordination state and neither can
# destroy the other's silver. The MongoDB volumes are shared by both modes and are
# not affected by this. (PostgreSQL is not: a Patroni data directory records the
# cluster identity and cannot be reused by the standalone server testing mode
# runs, so each mode keeps its own gold — which costs nothing, gold being derived.
# This line used to say "MongoDB and Oracle"; Oracle was replaced by PostgreSQL.)
STORE_VOLUMES=radar-testing

# A single replica can never satisfy a quorum of 2, so every insert would block.
CLICKHOUSE_INSERT_QUORUM=1

# Single-node MongoDB replica set. Still a replica set, not a standalone server,
# because the processing layer's trigger relies on change streams.
MONGO_MEMBERS=1
MONGO_MEMBER_0=mongo1:27017

# Single node, so it may use far more than one node of the six-node cluster.
CH_MEMORY_CONFIG=memory.local.xml

# The stores run on this machine, so join the network they created.
PIPELINE_NET_EXTERNAL=true

# Silver -> gold runs through PySpark in BOTH modes; only this differs.
# local[*] runs it inside the processing container on every available core, so
# testing mode needs no Spark master or worker containers at all — the same job,
# undistributed. Intended mode points this at the real cluster instead.
SPARK_MASTER=local[*]
# Spark defaults to 200 partitions per shuffle, which on this dataset is
# ~500 rows each — almost pure task-scheduling overhead on one machine.
SPARK_SHUFFLE_PARTITIONS=16
