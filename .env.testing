# ── TESTING MODE — everything on one machine, one node per store ─────────────
#
#   docker compose --env-file .env.testing -f docker-compose.stores.yml up -d
#   docker compose --env-file .env.testing up -d --build
#   docker compose -f 5-serving/docker-compose.serving.yml up --build
#
# Starts 4 store containers instead of 13 (~2 GB instead of ~6.1 GB), which is
# what makes the stack usable on a machine with 8 GB of RAM. Note the absence of
# `--profile full`: the redundant nodes are gated behind that profile and simply
# do not start here.
#
# No store addresses are set, so the compose defaults apply and every service is
# reached by its Docker service name on the shared network.

# Single-node ClickHouse topology (1 shard × 1 replica, 1 Keeper).
CH_CLUSTER_CONFIG=cluster.local.xml
CH_KEEPER1_CONFIG=keeper-1.local.xml

# Names this mode's ClickHouse and Keeper volumes. Intended mode uses a different
# prefix, so the two topologies never share coordination state and neither can
# destroy the other's silver. MongoDB and Oracle volumes are shared by both modes
# and are not affected by this.
STORE_VOLUMES=radar-testing

# A single replica can never satisfy a quorum of 2, so every insert would block.
CLICKHOUSE_INSERT_QUORUM=1

# Single-node MongoDB replica set. Still a replica set, not a standalone server,
# because the processing layer's trigger relies on change streams.
MONGO_MEMBERS=1
MONGO_MEMBER_0=mongo1:27017

# Single node, so it may use far more than one node of the six-node cluster.
CH_MEMORY_CONFIG=memory.local.xml

# The stores run on this machine, so join the network they created.
PIPELINE_NET_EXTERNAL=true
