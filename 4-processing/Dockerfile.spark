# Submitter image for a MANUAL, one-shot run of the distributed silver -> gold
# job. Identical to the processing image — same code, same jars — differing only
# in that it runs the job once and exits instead of serving the API.
#
# The normal path does NOT use this file: the resident processing container runs
# the same job itself, on whatever SPARK_MASTER names. This exists for a
# deliberate batch run (docker-compose.spark.yml), which is useful for a
# one-off rebuild or for watching the job in the Spark UI.
FROM radar-processing:latest

CMD ["spark-submit", \
     "--jars", "/opt/bitnami/spark/jars/clickhouse-jdbc.jar,/opt/bitnami/spark/jars/postgresql-jdbc.jar", \
     "--conf", "spark.sql.shuffle.partitions=16", \
     "spark_gold.py"]
