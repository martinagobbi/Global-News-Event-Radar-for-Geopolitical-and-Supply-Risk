# ── INTENDED MODE — one node of each store per machine, orchestrated by Swarm ─
#
# Replaces the old .env.full. The difference is that there is no longer a
# STORES_HOST to substitute: the stores run as a Swarm stack on a shared OVERLAY
# network, and overlay DNS resolves every service name across machines. So the
# addresses below are the same Docker service names testing mode uses, and this
# file needs no editing at all before use.
#
#   # once, on the first manager
#   docker swarm init --advertise-addr <this-machine-ip>
#   docker network create -d overlay --attachable pipeline_network
#
#   # on every other machine, with the token `swarm init` printed
#   docker swarm join --token <token> <manager-ip>:2377
#
#   # label the machines (see README: which node goes where)
#   docker node update --label-add store=store1 <hostname>   # …store2 … store6
#   docker node update --label-add role=pipeline <hostname>
#
#   # deploy. NOTE: `docker stack deploy` accepts no --env-file, so this file has
#   # to be sourced into the SHELL first.
#   set -a; . ./.env.intended; set +a
#   docker stack deploy -c docker-stack.stores.yml   radar-stores
#   docker stack deploy -c docker-stack.pipeline.yml radar
#
# Each user machine:
#   BACKEND_URL=http://<any-swarm-node>:8000 \
#     docker compose -f 5-serving/docker-compose.serving.yml up --build
# Any node works because Swarm's routing mesh forwards :8000 to a live backend.

# Full ClickHouse topology (2 shards × 3 replicas, 3-node Keeper ensemble).
CH_CLUSTER_CONFIG=cluster.xml
CH_KEEPER1_CONFIG=keeper-1.xml

# One ClickHouse node per machine, so it may take most of that machine rather
# than the 1.1 GB that six-on-one-host forced.
CH_MEMORY_CONFIG=memory.distributed.xml

# An insert is acknowledged only once it has reached 2 of the 3 shard replicas.
CLICKHOUSE_INSERT_QUORUM=2

# Entry nodes the pipeline falls back on when clickhouse-s1r1's MACHINE is lost.
# Without this the six-node cluster still holds every row but nothing can reach
# it, so the durability and the access path would tolerate different failures.
CLICKHOUSE_ALT_HOSTS=clickhouse-s1r2:9000,clickhouse-s1r3:9000

# Three-member MongoDB replica set. Service names, because the overlay resolves
# them on every machine — this is what replaced the old STORES_HOST:27017/8/9.
MONGO_MEMBERS=3
MONGO_MEMBER_0=mongo1:27017
MONGO_MEMBER_1=mongo2:27017
MONGO_MEMBER_2=mongo3:27017
MONGO_URI=mongodb://mongo1:27017,mongo2:27017,mongo3:27017/?replicaSet=rs0

# Gold: all three PostgreSQL members, with target_session_attrs=read-write so
# libpq itself connects to whichever node Patroni currently leads. A failover
# therefore changes nothing here — the same mechanism as CLICKHOUSE_ALT_HOSTS
# above and the three-member MONGO_URI: every store is addressed as a LIST.
POSTGRES_DSN=postgresql://radar:radar@postgres-1:5432,postgres-2:5432,postgres-3:5432/radar?target_session_attrs=read-write

# Silver entry point for the pipeline tier.
CLICKHOUSE_HOST=clickhouse-s1r1
CLICKHOUSE_PORT=9000

# The overlay is created by hand (see above) and shared by BOTH stacks, so every
# tier attaches to it as an external network rather than creating its own.
PIPELINE_NET_EXTERNAL=true

# Silver -> gold is distributed across the Spark workers deployed by
# docker-stack.pipeline.yml. Testing mode uses local[*] instead, which is the
# ONLY difference between the two in this respect.
SPARK_MASTER=spark://spark-master:7077
# How many partitions each shuffle produces. More than testing mode,
# because there are real executors to spread them across; scale it with
# the worker count. Spark's own default is 200.
SPARK_SHUFFLE_PARTITIONS=64
# Concurrent JDBC readers against ClickHouse and writers into PostgreSQL. Raise
# both as workers are added — they bound how much of the cluster is used.
SPARK_READ_PARTITIONS=8
SPARK_WRITE_PARTITIONS=4
# The Spark cluster itself: how many worker containers, and how much of a machine
# each may take. Swarm places them on any node, so this is the real "spread it
# across more machines" knob.
# One worker, because every Spark task is now pinned to the pipeline machine
# and must fit in its 8 GiB alongside the driver JVM (~1.9 GiB) and layers 1-3.
# Budget and the arithmetic for 2 workers are in docker-stack.pipeline.yml.
SPARK_WORKERS=1
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# Swarm cannot build from a Dockerfile: images must be built and pushed first.
# Point this at your registry (a Docker Hub user, or a private registry).
REGISTRY=localhost:5000
