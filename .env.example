# ═════════════════════════════════════════════════════════════════════════════
# Store addresses. Docker Compose auto-loads a file named `.env` in this folder.
#
#   cp .env.example .env      then edit the lines you need.
#
# SAME MACHINE (stores + pipeline on one host): leave EVERYTHING commented — the
# compose defaults use Docker service names and it just works.
#
# SEPARATE MACHINES: each host keeps its own `.env` and only needs the section
# for the role it runs. Set the addresses below to real IPs / DNS names.
# ═════════════════════════════════════════════════════════════════════════════

# ── On the STORES host  (docker compose -f docker-compose.stores.yml up -d) ───
# The addresses the Mongo replica set ADVERTISES to clients. They must be
# reachable from the pipeline machine: use THIS host's IP/DNS + the published
# ports below. (Oracle and ClickHouse don't need this — only Mongo redirects
# clients to member addresses.)
# MONGO_MEMBER_0=10.0.0.5:27017
# MONGO_MEMBER_1=10.0.0.5:27018
# MONGO_MEMBER_2=10.0.0.5:27019
#
# Host ports the stores publish (change only if they clash with something else):
# MONGO1_PUBLISH=27017
# MONGO2_PUBLISH=27018
# MONGO3_PUBLISH=27019
# CLICKHOUSE_PUBLISH=9000

# ── On the PIPELINE host  (docker compose up -d) ──────────────────────────────
# Point the pipeline at the stores host. MONGO_URI MUST list the SAME addresses
# the replica set advertises above (the MONGO_MEMBER_* values), or the driver
# will be redirected to an unreachable member.
# MONGO_URI=mongodb://10.0.0.5:27017,10.0.0.5:27018,10.0.0.5:27019/?replicaSet=rs0
# CLICKHOUSE_HOST=10.0.0.5
# ORACLE_HOST=10.0.0.5
# MONGO_DB=radar
# ORACLE_SERVICE=FREEPDB1
