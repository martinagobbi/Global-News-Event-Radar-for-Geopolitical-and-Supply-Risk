# ── INTENDED MODE — full clusters, tiers on separate machines ────────────────
#
# Stores machine:
#   docker compose --env-file .env.full -f docker-compose.stores.yml --profile full up -d
#
# Pipeline machine:
#   docker compose --env-file .env.full up -d --build
#
# No extra -f file is needed: PIPELINE_NET_EXTERNAL=false (set at the bottom of
# this file) makes Compose create `pipeline_network` here instead of expecting
# the stores to have created it.
#
# Each user machine:
#   BACKEND_URL=http://<pipeline-host>:8000 \
#     docker compose -f 5-serving/docker-compose.serving.yml up --build
#
# `--profile full` is what starts the redundant nodes: 6 ClickHouse servers,
# 3 Keepers and 3 MongoDB members. Requires roughly 6 GB for the stores alone.
#
# Replace STORES_HOST below with the stores machine's real address before use.
# On the STORES machine the MONGO_MEMBER_* values must be that machine's own
# address; on the PIPELINE machine MONGO_URI must list the same three addresses,
# or the driver will be redirected to a member it cannot reach.

# Full ClickHouse topology (2 shards × 3 replicas, 3-node Keeper ensemble).
CH_CLUSTER_CONFIG=cluster.xml
CH_KEEPER1_CONFIG=keeper-1.xml

# Names this mode's ClickHouse and Keeper volumes. Testing mode uses a different
# prefix, so the two topologies never share coordination state and neither can
# destroy the other's silver. MongoDB and Oracle volumes are shared by both modes
# and are not affected by this.
STORE_VOLUMES=radar-full

# An insert is acknowledged only once it has reached 2 of the 3 shard replicas.
CLICKHOUSE_INSERT_QUORUM=2

# Three-member MongoDB replica set.
MONGO_MEMBERS=3
MONGO_MEMBER_0=STORES_HOST:27017
MONGO_MEMBER_1=STORES_HOST:27018
MONGO_MEMBER_2=STORES_HOST:27019

# Store addresses used by the pipeline tier. Leave these commented out when the
# stores happen to run on the same machine as the pipeline.
# MONGO_URI=mongodb://STORES_HOST:27017,STORES_HOST:27018,STORES_HOST:27019/?replicaSet=rs0
# CLICKHOUSE_HOST=STORES_HOST
# ORACLE_HOST=STORES_HOST

# Six nodes share the host, so each is capped tightly.
CH_MEMORY_CONFIG=memory.xml

# The pipeline machine runs no stores, so it must create its own network.
# Setting this false makes the `external` key disappear from the merged config.
PIPELINE_NET_EXTERNAL=false
